# Copy to .env and adjust as needed. All values are optional — sane defaults are baked in.

# --- Storage ---
# STORAGE_DIR=storage
# RETENTION_HOURS=24

# --- Upload limits ---
# MAX_UPLOAD_BYTES=2147483648      # 2 GiB
# MAX_DURATION_SECONDS=3900        # ~65 min

# --- Montage shape ---
# MAX_MONTAGE_LEN=60.0             # seconds
# TARGET_SEGMENTS=8

# --- Audio detection tuning ---
# THRESHOLD_K=1.0
# MIN_PEAK_GAP=3.0
# LEAD_IN=2.0
# LEAD_OUT=3.0
# MERGE_GAP=1.0

# --- AI tier (browser WebGPU) ---
# Must be an ONNX / Transformers.js-compatible repo (has an onnx/ folder).
# VLM_MODEL_ID=LiquidAI/LFM2.5-VL-450M-ONNX
#   alternatives: HuggingFaceTB/SmolVLM-256M-Instruct, HuggingFaceTB/SmolVLM-500M-Instruct
# MAX_FRAMES_PER_SEGMENT=6
# CLIENT_SCORING_TIMEOUT=300       # seconds to wait for browser scores before audio-only fallback

# --- Free-tier usage cap ---
# FREE_DAILY_LIMIT=5

# --- Dev override ---
# Set to "true" to skip credit/VIP gating so you can try the AI tier yourself
# without a payment flow. LOCAL/DEV USE ONLY.
# BYPASS_CREDITS=true
